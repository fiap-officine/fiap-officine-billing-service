# ── Banco (billing_db) ──────────────────────────
DB_USER=billing_service
DB_PASSWORD=billing_service
DB_HOST=localhost
DB_PORT=5433
DB_NAME=billing_db

# ── Autenticação (mesmo segredo da Lambda e do OS Service) ──
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# ── Mercado Pago ────────────────────────────────
# fake (sem credenciais) | mercadopago (sandbox: credenciais de TESTE)
PAYMENT_GATEWAY=fake
MP_ACCESS_TOKEN=TEST-...
# Painel MP > Suas integrações > Webhooks > Assinatura secreta
MP_WEBHOOK_SECRET=
# URL pública que o MP chama (rota sem authorizer no API Gateway)
MP_NOTIFICATION_URL=https://<api-gateway>/api/v1/pagamentos/webhook
MP_USE_SANDBOX_URL=true
PAYMENT_EXPIRATION_MINUTES=30

# ── Mensageria (SQS / LocalStack) ───────────────
AWS_REGION=sa-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_PREFIX=fiap-officine
RUN_WORKERS=true

# ── App / Observabilidade ───────────────────────
APP_ENV=development
LOG_LEVEL=INFO
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=officine-billing-service
